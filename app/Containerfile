# AI Travel Advisor - Containerfile
# Build: docker build -f Containerfile -t ghcr.io/popecruzdt/enablement-openinference-aiobs/ai-travel-advisor:<version> .
# Runtime configuration comes from environment variables (Kubernetes ConfigMap), not a baked .env.

FROM python:3.13-slim

WORKDIR /app

# Install system deps required by python packages and runtime health checks.
RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc \
    g++ \
    curl \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY src/ ./src/
COPY public/ ./public/
COPY prompts/ ./prompts/
COPY destinations/ ./destinations/

RUN useradd -m -u 1000 appuser && chown -R appuser:appuser /app
USER appuser

ENV PYTHONUNBUFFERED=1
ENV PYTHONDONTWRITEBYTECODE=1

EXPOSE 8080

CMD ["python", "-m", "src.main"]
